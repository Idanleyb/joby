# Copy to .env.local and fill in. Never commit .env.local.
# Values: Supabase dashboard → Project Settings → API (or `npx supabase status` for local).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret salt for hashing ID numbers from Form 3010 (generate: openssl rand -hex 32)
ID_HASH_SALT=

# AI reading of Form 3010 and CVs (console.anthropic.com). Without it the app falls back
# to manual entry. ANTHROPIC_MODEL is optional (default claude-sonnet-5-5).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Tests only: canned AI readings so e2e tests run without an API key. Never set in production.
# JOBY_AI_FAKE=1

# Outgoing email — REQUIRED: sign-up email codes, admin invitations and the lifecycle emails.
# Production (Resend): host smtp.resend.com, port 465, user "resend", password = a Resend API key,
# sender on the verified domain. Without SMTP_HOST new accounts cannot confirm their email.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxx
# MAIL_FROM="Joby <hello@mail.joby-ai.com>"

# Lifecycle email worker (/api/notifications/dispatch). pg_cron calls it with this secret
# (store the same value in Supabase Vault as joby_cron_secret). Generate: openssl rand -hex 32
# CRON_SECRET=
# Support links inside emails: WhatsApp number (digits, e.g. 972501234567) and/or an address
# SUPPORT_WHATSAPP=
# SUPPORT_EMAIL=support@joby-ai.com

# Added in later steps
# WHATSAPP_TOKEN=             # WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=

# Optional: minutes without activity before automatic sign-out (default 60)
# NEXT_PUBLIC_IDLE_MINUTES=60

# Optional: hide the one-click demo accounts on the sign-in page (shown only while demo data is loaded)
# DEMO_LOGIN=off
